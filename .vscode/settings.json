{
	"files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true,
        ".husky": true,
        "node_modules": true,
        "LICENSE": true,
        "pnpm-lock.yaml": true,
        ".npmrc": true,
        "commitlint.config.mjs": true,
        "pnpm-workspace.yaml": true,
        "postcss.config.mjs": true,
        "vitest.config.mts": true,
        ".next": true,
        "junit.xml": true,
        ".github": true,
        ".env.example": true,
        "coverage": true,
        "next-env.d.ts": true,
        ".gitignore": true
    },

	"hide-files.files": [
		".husky",
		"node_modules",
		"LICENSE",
		"pnpm-lock.yaml",
		".npmrc",
		"commitlint.config.mjs",
		"pnpm-workspace.yaml",
		"postcss.config.mjs",
		"vitest.config.mts",
		".next",
		"junit.xml",
		".github",
		".env.example",
		"coverage",
		"next-env.d.ts",
		".gitignore"
	],
	"typescript.tsdk": "node_modules\\typescript\\lib",
    "tailwindCSS.experimental.classRegex": [["tv\\(\\{([\\s\\S]*?)\\}\\)", "'([^']*)'"]],
	"typescript.preferences.autoImportFileExcludePatterns": [
		"**/node_modules/tailwind-variants"
	]
}
