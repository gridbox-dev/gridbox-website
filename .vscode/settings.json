{
	"files.exclude": {
		"**/.git": true,
		"**/.svn": true,
		"**/.hg": true,
		"**/.DS_Store": true,
		"**/Thumbs.db": true,
		".husky": true,
		"node_modules": true,
		".gitignore": true,
		"LICENSE": true,
		"next-env.d.ts": true,
		"pnpm-lock.yaml": true,
		".npmrc": true,
		"commitlint.config.mjs": true,
		"pnpm-workspace.yaml": true,
		"postcss.config.mjs": true,
		"vitest.config.mts": true,
		".vscode": true,
		".next": true,
		"junit.xml": true
	},
	"hide-files.files": [
		".husky",
		"node_modules",
		".gitignore",
		"LICENSE",
		"next-env.d.ts",
		"pnpm-lock.yaml",
		".npmrc",
		"commitlint.config.mjs",
		"pnpm-workspace.yaml",
		"postcss.config.mjs",
		"vitest.config.mts",
		".vscode",
		".next",
		"junit.xml"
	],

	"tailwindCSS.experimental.classRegex": [["tv\\(\\{([\\s\\S]*?)\\}\\)", "'([^']*)'"]],
	"typescript.preferences.autoImportFileExcludePatterns": ["**/node_modules/tailwind-variants"]
}
