{
	"name": "@gridbox-dev/gridbox-website",
	"version": "0.0.0",
	"description": "Custom software development and strategic IT consulting in Chile.",
	"author": {
		"name": "Gridbox Development SpA",
		"email": "hola@gridbox.dev",
		"url": "https://gridbox.dev"
	},
	"homepage": "https://gridbox.dev",
	"packageManager": "pnpm@11.25.0",
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"build:watch": "next build && next start",
		"start": "next start",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format .",
		"format:fix": "biome format --write .",
		"prepare": "husky",
		"test": "vitest",
		"test:ui": "vitest --ui",
		"test:verbose": "vitest --reporter=verbose",
		"test:coverage": "vitest run --coverage --passWithNoTests",
		"typecheck": "next typegen && tsc --noEmit"
	},
	"dependencies": {
		"@formatjs/intl-localematcher": "^0.8.13",
		"@gsap/react": "^2.1.2",
		"@next/env": "^16.3.4",
		"@radix-ui/react-slot": "^1.3.3",
		"@t3-oss/env-nextjs": "^0.13.11",
		"gsap": "^3.15.0",
		"klsx": "^0.3.3",
		"negotiator": "^1.1.0",
		"next": "^16.3.4",
		"react": "^19.2.8",
		"react-aria": "^3.52.0",
		"react-dom": "^19.2.8",
		"server-only": "^0.0.1",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"zod": "^4.5.4",
		"zustand": "^5.0.15"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.11",
		"@commitlint/cli": "^21.2.2",
		"@commitlint/config-conventional": "^21.2.2",
		"@tailwindcss/postcss": "^4.3.3",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.6",
		"@types/negotiator": "^0.6.5",
		"@types/node": "^20",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@vitest/coverage-v8": "^4.1.11",
		"@vitest/ui": "^4.1.11",
		"babel-plugin-react-compiler": "^1.0.0",
		"husky": "^9.1.7",
		"jsdom": "^30.0.1",
		"lint-staged": "^17.4.1",
		"tailwindcss": "^4",
		"typescript": "^5",
		"vitest": "^4.1.11"
	},
	"lint-staged": {
		"*.{js,ts,jsx,tsx,json,css}": [
			"biome check --write --no-errors-on-unmatched"
		]
	}
}
