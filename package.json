{
	"name": "@gridbox-dev/gridbox-website",
	"version": "0.0.0",
	"description": "Custom software development and strategic IT consulting in Latin America.",
	"author": {
		"name": "Gridbox Development SpA",
		"email": "hola@gridbox.dev",
		"url": "https://gridbox.dev"
	},
	"homepage": "https://gridbox.dev",
	"packageManager": "pnpm@11.21.0",
	"private": true,
	"scripts": {
		"test": "vitest",
		"test:run": "vitest run",
		"test:ui": "vitest --ui",
		"test:verbose": "vitest --reporter=verbose",
		"test:coverage": "vitest run --coverage",
		"dev": "tsx scripts/clean-next-cache.ts && next dev",
		"build": "next build",
		"start": "next start",
		"lint": "biome check .",
		"format": "biome format --write .",
		"check": "biome check --write .",
		"prepare": "husky"
	},
	"dependencies": {
		"@formatjs/intl-localematcher": "^0.8.13",
		"@next/env": "^16.3.1",
		"negotiator": "^1.0.0",
		"next": "16.3.1",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.8",
		"@commitlint/cli": "^21.2.2",
		"@commitlint/config-conventional": "^21.2.2",
		"@tailwindcss/postcss": "^4",
		"@types/negotiator": "^0.6.5",
		"@types/node": "^20",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@vitest/coverage-v8": "4.1.10",
		"@vitest/ui": "4.1.10",
		"babel-plugin-react-compiler": "1.0.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.3.0",
		"tailwindcss": "^4",
		"tsx": "^4.23.12",
		"typescript": "^5",
		"vitest": "^4.1.10"
	},
	"lint-staged": {
		"*.{js,ts,jsx,tsx,json,css}": [
			"biome check --write --no-errors-on-unmatched"
		]
	}
}
