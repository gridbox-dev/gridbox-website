{
	"$schema": "https://biomejs.dev/schemas/2.0.5/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": true
	},
	"formatter": {
		"enabled": true,
		"formatWithErrors": false,
		"attributePosition": "auto",
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineWidth": 95
	},
	"linter": {
		"enabled": false
	},
	"assist": {
		"enabled": false
	},

	"javascript": {
		"formatter": {
			"enabled": true,
			"lineWidth": 95,
			"indentStyle": "tab",
			"indentWidth": 2,
			"semicolons": "always",
			"quoteStyle": "single",
			"bracketSameLine": false,
			"bracketSpacing": true
		}
	},

	"html": {
		"formatter": {
			"enabled": true,
			"lineWidth": 95,
			"indentStyle": "tab",
			"indentWidth": 2,
			"bracketSameLine": false
		}
	}
}
